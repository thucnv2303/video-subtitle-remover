+// --- UI Helpers for AI Settings ---
+function _bindAiProviderToggle() {
+    const aiProvider = document.getElementById('ai-provider');
+    const cloudPanel = document.getElementById('cloud-ai-panel');
+    const localPanel = document.getElementById('local-ai-panel');
+    if (!aiProvider) return;
+    
+    function updatePanels() {
+        if (aiProvider.value === 'ollama') {
+            if (cloudPanel) cloudPanel.style.display = 'none';
+            if (localPanel) localPanel.style.display = 'block';
+        } else {
+            if (cloudPanel) cloudPanel.style.display = 'block';
+            if (localPanel) localPanel.style.display = 'none';
+        }
+    }
+    aiProvider.addEventListener('change', updatePanels);
+    setTimeout(updatePanels, 50);
+}
+
+function _bindScanModels() {
+    const btn = document.getElementById('btn-scan-models');
+    if (!btn) return;
+    btn.addEventListener('click', async () => {
+        const endpoint = document.getElementById('ai-endpoint')?.value || '';
+        const provider = document.getElementById('ai-provider')?.value || 'ollama';
+        if (provider !== 'ollama') return;
+        
+        btn.disabled = true;
+        btn.textContent = 'Đang quét...';
+        try {
+            const res = await fetch('http://localhost:8765/api/ai/models', {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ provider, endpoint })
+            });
+            const data = await res.json();
+            if (data.status === 'ok') {
+                const select = document.getElementById('ai-ollama-model');
+                if (select) {
+                    select.innerHTML = '';
+                    if (data.models.length === 0) {
+                        const opt = document.createElement('option');
+                        opt.value = '';
+                        opt.textContent = 'Không tìm thấy model nào';
+                        select.appendChild(opt);
+                    } else {
+                        data.models.forEach(m => {
+                            const opt = document.createElement('option');
+                            opt.value = m;
+                            opt.textContent = m;
+                            select.appendChild(opt);
+                        });
+                        
+                        const savedModel = localStorage.getItem('ai_model');
+                        if (savedModel && [...select.options].some(o => o.value === savedModel)) {
+                            select.value = savedModel;
+                        }
+                    }
+                }
+                const addLog = window.addLog || ((msg, t) => console.log(msg));
+                addLog(`Tìm thấy ${data.models.length} model Ollama`, 'success');
+            } else {
+                const addLog = window.addLog || ((msg, t) => console.log(msg));
+                addLog(`Quét model thất bại: ${data.error}`, 'error');
+            }
+        } catch (e) {
+            const addLog = window.addLog || ((msg, t) => console.log(msg));
+            addLog(`Lỗi kết nối khi quét model: ${e}`, 'error');
+        } finally {
+            btn.disabled = false;
+            btn.textContent = 'Quét';
+        }
+    });
+}
